pragma solidity ^0.8.36;

interface IERC20Basic {
    function totalSupply() external view returns (uint256);
}

contract Ownable {
    address public owner;

    constructor() {
        owner = msg.sender;
    }

    modifier onlyOwner() {
        require(msg.sender == owner, "Not the contract owner!");
        _;
    }
}

contract DaySix is Ownable {
    
    function changeOwner(address _newOwner) public onlyOwner {
        owner = _newOwner;
    }

    function getExternalTotalSupply(address _tokenAddress) public view returns (uint256) {
        return IERC20Basic(_tokenAddress).totalSupply();
    }
}
